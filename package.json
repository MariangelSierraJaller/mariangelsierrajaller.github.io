    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:contrast": "bun scripts/check-contrast.mjs",
    "check:links": "bun scripts/check-links.mjs",
    "generate:og": "bun scripts/generate-og.mjs",
    "generate:cv": "bun scripts/render-resumes.mjs",
