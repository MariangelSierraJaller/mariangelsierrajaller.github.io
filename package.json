    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.2",
    "pdfkit": "^0.17.2",
    "sharp": "^0.34.5",
